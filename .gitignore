# Python bytecode
__pycache__/

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
*.swp
*.swo

# Personal config (gitignored — copy from config.example.yaml)
config.yaml
.env

# cmux browser auth-state files (cookies + localStorage from authenticated sessions)
.auth-state-*.json
.env.*
!.env.example

# Calibration data (personal estimation history)
context/calibration.md

# Session scratch files
context/notes/scratch-*

# Local overrides
*.local.yaml
skills-local.yaml
context/repo-context/local.overrides.yaml
secrets/

# Junctions/symlinks created by setup.sh (NOT committed to git)
.claude/CLAUDE.md
.claude/agents
.claude/hooks
.claude/skills
.cursor/agents
.cursor/hooks
.cursor/skills
.cursor/mcp.json

# Machine-specific generated config
scripts/windows/wt-config.sh

# Claude Code local settings (machine-specific permissions)
.claude/settings.local.json

# Entire CLI (session data, not committed)
.entire/

# Machine-specific .cmd config
scripts/windows/bin/wt-config.cmd

# context/repo-context and config/appinsights may be tracked symlinks into
# a private knowledge-graph repository. Workbench reads it through these links.
# A fresh workbench clone needs that private repo at the linked path to resolve.
